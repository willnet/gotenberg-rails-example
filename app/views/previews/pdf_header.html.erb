<!DOCTYPE html>
<html class="pdf-header-html">
  <head>
    <meta charset="utf-8">
    <style>
      .pdf-header-html {
        width: 100%;
      }
      .pdf-header-body {
        -webkit-print-color-adjust: exact;
        box-sizing: border-box;
        color: #526068;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        margin: 0;
        padding: 0 28px;
        width: 100%;
      }
      .pdf-header-line {
        align-items: center;
        border-bottom: 1px solid #d7ded9;
        display: flex;
        justify-content: space-between;
        padding: 12px 0 8px;
        width: calc(8.27in - 56px);
      }
      .pdf-header-brand {
        color: #0f766e;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .pdf-header-title {
        font-size: 11px;
      }
    </style>
  </head>
  <body class="pdf-header-body">
    <div class="pdf-header-line">
      <span class="pdf-header-brand">gotenberg-rails example</span>
      <span class="pdf-header-title"><%= @preview[:title] %></span>
    </div>
  </body>
</html>
