<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
      @page { size: A4; margin: 0.75in 0; }
      body {
        background: #f6f1e8;
        color: #1f2933;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 18mm;
      }
      .card {
        background: #ffffff;
        border: 1px solid #d7c8ad;
        border-radius: 8px;
        padding: 32px;
      }
      h1 {
        color: #0f766e;
        font-size: 30px;
        margin: 0 0 12px;
      }
      p {
        font-size: 15px;
        line-height: 1.7;
        margin: 0;
      }
      code {
        background: #eef6f5;
        border-radius: 4px;
        padding: 2px 5px;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>Direct HTML PDF</h1>
      <p>
        This PDF was generated by calling
        <code>Gotenberg::Rails.render_pdf(html: ...)</code> directly from a Rails
        controller action.
      </p>
    </main>
  </body>
</html>
